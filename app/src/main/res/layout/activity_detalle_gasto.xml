<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="24dp" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Detalle del gasto" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvDetalleDescripcion" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="Cargando…" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvDetalleMonto" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="24sp" />
        <TextView android:id="@+id/tvDetalleCategoria" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="18sp" />
        <TextView android:id="@+id/tvDetalleFecha" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="18sp" />
        <Button android:id="@+id/btnEditarGasto" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="32dp"
            android:minHeight="48dp" android:text="Editar" android:enabled="false" />
        <Button android:id="@+id/btnEliminarGasto" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="Eliminar" android:enabled="false" />
        <Button android:id="@+id/btnVolverGastos" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="Volver a mis gastos" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
